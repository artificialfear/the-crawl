rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each crawler's own save: only that signed-in player can read or write it.
    match /data/users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    function signedIn() { return request.auth != null; }
    function isMember(code) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/parties/$(code)).data.members;
    }

    // A party. Anyone signed in can look one up by its code (needed to join); nobody can list them.
    match /parties/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'created'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'name'])
        && (
          // join: add only yourself, up to 6
          (request.resource.data.name == resource.data.name
            && !(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.size() <= 6)
          // leave: remove only yourself
          || (request.resource.data.name == resource.data.name
            && request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members)
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1)
          // rename: any member
          || (request.auth.uid in resource.data.members
            && request.resource.data.members == resource.data.members
            && request.resource.data.name is string && request.resource.data.name.size() <= 40)
        );

      // Each member's public card: readable by the party, written only by its owner.
      match /cards/{uid} {
        allow read: if isMember(code);
        allow create, update: if request.auth.uid == uid && isMember(code);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Party chat: members post as themselves and may delete only their own messages.
      match /chat/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // Gifts and trades: the sender creates an open offer to another member. Only the receiver can
      // claim, accept or decline it; only the sender can cancel it or mark it settled (once).
      match /gifts/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code)
          && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'item', 'want', 'kind', 'status', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to != request.auth.uid
          && request.resource.data.to in get(/databases/$(database)/documents/parties/$(code)).data.members
          && request.resource.data.status == 'open'
          && request.resource.data.kind in ['gift', 'trade']
          && request.resource.data.item is string && request.resource.data.item.size() <= 12
          && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40;
        allow update: if isMember(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'done'])
          && (
            (request.auth.uid == resource.data.to && resource.data.status == 'open'
              && request.resource.data.status in ['claimed', 'accepted', 'declined'])
            || (request.auth.uid == resource.data.from && resource.data.status == 'open'
              && request.resource.data.status == 'cancelled')
            || (request.auth.uid == resource.data.from && request.resource.data.status == resource.data.status
              && resource.data.status in ['accepted', 'declined']
              && !('done' in resource.data) && request.resource.data.done == true)
          );
        allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      }

      // Party feed: members post as themselves; others can only add or remove their own cheer.
      match /feed/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 200
          && request.resource.data.cheers.size() == 0;
        allow update: if isMember(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheers'])
          && request.resource.data.cheers.diff(resource.data.cheers).affectedKeys().hasOnly([request.auth.uid]);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
